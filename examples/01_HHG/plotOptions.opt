[expectationValues]
plotCurrentRelativeThreshold = 1e-4
plotErelativeThreshold = 0.05


# This section defines how the HHG spectrum is calculated
[spectrum]
# range
omegaMin_eV = 0.1
omegaMax_eV = 6
dOmega_eV  = 0.04 # minimum resolution
useFFT = 1 # FFT will be used, this may result in better higher resolution
fadeOut_rel = 0.1 # the last 10% of the current will be damped when using FFT to zero to ensure periodic boundary conditions

# width of gaussian smearing after calculation of spectra
smearingWidth_rel = 0.1 # in units of fundamental energy
# smearingWidth_eV = 0.1 # in eV
